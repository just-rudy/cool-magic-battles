# Скопируйте в .env в корне проекта:
#   cp env.example .env
#
# --- Вариант A: локальный PostgreSQL (без Docker), peer auth ---
# Пользователь ОС должен иметь право CREATE DB (как у вас: rudy).
# База: cool_magic_battles (создаётся скриптом или вручную).
DATABASE_URL=postgresql+psycopg:///cool_magic_battles

# --- Вариант B: Docker (make db-up) — порт 5433, см. docker-compose.yml ---
# DATABASE_URL=postgresql+psycopg://cmb:cmb@localhost:5433/cool_magic_battles
