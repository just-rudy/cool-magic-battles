@startuml
actor Player as player
participant "WebUI" as web
participant "API Controller" as api
participant "Game Logic" as game
participant "Game State Machine" as state
participant "Card Logic" as card
participant "Data Access Layer" as data

player -> web: нажимает "сыграть карту"
web -> api: playCard(gameId, cardId)
api -> game: play_card(gameId, playerId, cardId)

game -> data: get_game(gameId)
data --> game: game: GameSession

game -> state: validate_turn(game, playerId)
state --> game: if_valid (ok/error)

alt valid turn
    game -> data: get_card(cardId)
    data --> game: card: Card

    game -> card: apply_card_effects(game, card)
    card --> game: updated game

    game -> state: check_endgame(game)
    state --> game: end/continue

    alt game ended:
        game -> state: determine_winner(game)
        state --> game: winner

        game -> data: save_game(game)

        game -> api: game over + winner
        api --> web: game over + winner
        web --> player: показать результат игры
    else game continues:
        game -> data: save_game(game)

        game -> api: success response
        api --> web: success response
        web --> player: обновить интерфейс
    end

else invalid turn
    game --> api: error response
    api --> web: error response
    web --> player: показать сообщение об ошибке
end

@enduml